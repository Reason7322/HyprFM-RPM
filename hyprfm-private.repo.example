[hyprfm-private]
name=HyprFM RPM (public GitHub release mirror)
baseurl=file://@HOME@/.local/share/hyprfm-rpm-repo
enabled=1
gpgcheck=0
metadata_expire=1h

# Replace @HOME@ with the absolute path to your home directory before installing.
# Local package downloads are SHA-256 checked, but RPMs are NOT GPG-signed.
